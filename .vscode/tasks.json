{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Serve Damol Concept (8080)",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\.vscode\\serve.ps1"
			],
			"isBackground": true,
			"problemMatcher": {
				"owner": "custom",
				"pattern": {
					"regexp": "^(.*)$",
					"message": 1
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "Serving Damol Concept at http://localhost:8080",
					"endsPattern": "^Server stopped$"
				}
			},
			"runOptions": {
				"runOn": "folderOpen"
			}
		},
		{
			"label": "Stop Damol Concept (8080)",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\.vscode\\serve.ps1",
				"-StopExisting"
			],
			"problemMatcher": []
		}
	]
}